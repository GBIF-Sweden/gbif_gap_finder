# ==============================================================================
# gbifgaps — .gitignore
# ==============================================================================

# --- R session files ---
.Rproj.user
.Rhistory
.RData
.Ruserdata
.Renviron
.Rprofile

# --- targets cache (regenerated by tar_make()) ---
_targets/

# --- renv library (regenerated by renv::restore()) ---
renv/
!renv/activate.R
!renv/.gitignore

# --- Data (too large for git — regenerated by pipeline) ---
# Covers raw downloads, processed parquet/gpkg, derived CSVs, output tables
data/**
!data/.gitkeep

# --- Pipeline outputs (regenerated by script 10) ---
output/**
!output/.gitkeep

# --- Logs (auto-generated by scripts) ---
logs/**
!logs/.gitkeep

# --- Temporary / working files ---
temporary/
*.tmp

# --- Auto-generated metadata ---
download_metadata.json

# --- OS clutter ---
.DS_Store
Thumbs.db
desktop.inishiny_app/gbif_explorer/data/
