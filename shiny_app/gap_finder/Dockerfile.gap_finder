# Base image pinned BY DIGEST, not just by tag. A tag can be re-pushed, so two
# builds of "the same" image can differ. The apt packages are pinned too, by
# an Ubuntu archive snapshot date (APT_SNAPSHOT below), so GDAL/GEOS/PROJ cannot
# move underneath sf/terra between rebuilds with nothing in this repo changing.
# The digest is the multi-arch index for rocker/r-ver:4.5.2, as reported by
# `docker buildx imagetools inspect rocker/r-ver:4.5.2`. Dependabot proposes
# bumps (.github/dependabot.yml).
#
# apt pinning: every apt call reads the Ubuntu archive as
# it was at APT_SNAPSHOT (snapshot.ubuntu.com, apt >= 2.7 on noble), so the
# system libraries are identical on every rebuild. Individual version pins are
# not used: Ubuntu drops superseded versions from the live archive, which would
# break the build at the next security update. Trade-off: security fixes arrive
# only when this date moves. Bump it deliberately at each release (and after a
# security advisory for GDAL/PROJ/GEOS/curl/openssl), then rebuild and check.
# `--error-on=any` makes a failed snapshot fetch stop the build instead of
# installing from stale or empty package lists.
ARG APT_SNAPSHOT=20261006T000000Z

FROM rocker/r-ver:4.5.3@sha256:c3f39b365d1077fe24f8e9ab2742e352b6d3950897f51af1624a5bb5550c21c0 AS builder
ARG APT_SNAPSHOT

ENV DEBIAN_FRONTEND=noninteractive
ENV RENV_CONFIG_PAK_ENABLED=FALSE

# librdf0-dev: `redland` (via rdflib <- mregions2, the optional marine EEZ
# fetcher) compiles against the Redland C libraries (librdf/raptor/rasqal).
# renv::restore() installs every package in renv.lock, not only what app.R
# loads, so without it the image build fails at `redland`. Package names are
# for Ubuntu 24.04 (noble), the base of rocker/r-ver:4.5.x.
RUN echo "APT::Snapshot \"${APT_SNAPSHOT}\";" > /etc/apt/apt.conf.d/50snapshot \
    && apt-get update --error-on=any && apt-get install -y --no-install-recommends \
    cmake \
    g++ \
    gdal-bin \
    libcurl4-openssl-dev \
    libfontconfig1-dev \
    libfribidi-dev \
    libfreetype6-dev \
    libgdal-dev \
    libgeos-dev \
    libglpk-dev \
    libharfbuzz-dev \
    libjpeg-dev \
    libpng-dev \
    libproj-dev \
    librdf0-dev \
    libssl-dev \
    libtiff5-dev \
    libudunits2-dev \
    libxml2-dev \
    make \
    && rm -rf /var/lib/apt/lists/*

RUN R -q -e "install.packages('renv', repos = 'https://packagemanager.posit.co/cran/latest')"

WORKDIR /opt/project

COPY renv.lock ./renv.lock

RUN R -q -e "renv::consent(provided = TRUE); renv::restore(lockfile = 'renv.lock', library = '/usr/local/lib/R/site-library', prompt = FALSE)"

FROM rocker/r-ver:4.5.3@sha256:c3f39b365d1077fe24f8e9ab2742e352b6d3950897f51af1624a5bb5550c21c0
ARG APT_SNAPSHOT

ENV DEBIAN_FRONTEND=noninteractive

# Country selector — override at build time with --build-arg GBIF_GAP_COUNTRY=NO.
# Drives which config + data bundle are copied and the app's runtime lookup.
ARG GBIF_GAP_COUNTRY=SE
ENV GBIF_GAP_COUNTRY=${GBIF_GAP_COUNTRY}

# Release version, baked in at build time — CI passes the pushed git tag. There
# is no git inside the image, so this environment variable is what app.R reads
# (Sys.getenv("GAP_FINDER_VERSION", "dev")). A local `docker build` with no
# --build-arg produces an image that honestly reports itself as "dev".
ARG GAP_FINDER_VERSION=dev
ENV GAP_FINDER_VERSION=${GAP_FINDER_VERSION}

RUN echo "APT::Snapshot \"${APT_SNAPSHOT}\";" > /etc/apt/apt.conf.d/50snapshot \
    && apt-get update --error-on=any && apt-get install -y --no-install-recommends \
    libcurl4 \
    libfontconfig1 \
    libfribidi0 \
    libfreetype6 \
    libgdal-dev \
    libgeos-dev \
    libglpk40 \
    libharfbuzz0b \
    libjpeg-dev \
    libpng16-16 \
    libproj-dev \
    librdf0t64 \
    libssl3 \
    libtiff6 \
    libudunits2-0 \
    libxml2 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/R/site-library /usr/local/lib/R/site-library

WORKDIR /opt/project

# Country config, kept alongside the app for provenance (country is baked into
# the bundle metadata; app.R does not read this file at runtime).
COPY configs/config_${GBIF_GAP_COUNTRY}.yml ./configs/config_${GBIF_GAP_COUNTRY}.yml

# App code + data bundle + static assets (styles, self-hosted fonts)
COPY shiny_app/gap_finder/app.R         ./shiny_app/gap_finder/app.R
COPY shiny_app/gap_finder/data/${GBIF_GAP_COUNTRY}/shiny_data.rds ./shiny_app/gap_finder/data/${GBIF_GAP_COUNTRY}/shiny_data.rds
COPY shiny_app/gap_finder/www/ ./shiny_app/gap_finder/www/

# Fail the build if Git LFS was not fetched and the bundle is still a pointer
# file (~130 bytes) instead of the real ~90 MB RDS. Catches a broken image at
# build time (red CI) rather than at container start.
RUN R -q -e "stopifnot(file.exists('shiny_app/gap_finder/data/${GBIF_GAP_COUNTRY}/shiny_data.rds')); invisible(readRDS('shiny_app/gap_finder/data/${GBIF_GAP_COUNTRY}/shiny_data.rds')); cat('OK: data bundle is a real RDS\n')"

EXPOSE 3838

WORKDIR /opt/project/shiny_app/gap_finder

CMD ["R", "-q", "-e", "options(shiny.host = '0.0.0.0', shiny.port = 3838); shiny::runApp('.')"]
