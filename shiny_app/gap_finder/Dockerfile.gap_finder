# Base image pinned BY DIGEST, not just by tag. A tag can be re-pushed, so two
# builds of "the same" image can differ. The apt packages are pinned too, by
# an Ubuntu archive snapshot date (APT_SNAPSHOT below), so GDAL/GEOS/PROJ cannot
# move underneath sf/terra between rebuilds with nothing in this repo changing.
# The digest is the multi-arch index for rocker/r-ver:4.6.2, as reported by
# `docker buildx imagetools inspect rocker/r-ver:4.6.2`. Dependabot proposes
# bumps (.github/dependabot.yml).
#
# apt pinning: every apt call reads the Ubuntu archive as
# it was at APT_SNAPSHOT (snapshot.ubuntu.com, apt >= 2.7), so the
# system libraries are identical on every rebuild. Individual version pins are
# not used: Ubuntu drops superseded versions from the live archive, which would
# break the build at the next security update. Trade-off: security fixes arrive
# only when this date moves. Bump it deliberately at each release (and after a
# security advisory for GDAL/PROJ/GEOS/curl/openssl), then rebuild and check.
# `--error-on=any` makes a failed snapshot fetch fail the update instead of
# installing from stale or empty package lists.
# The snapshot server answers with 5xx errors at times, briefly or for hours.
# So apt retries each download up to 8 times, up to 60 s apart (80retries),
# and a failed `apt-get update` runs once more after 60 s. If the snapshot
# still fails, the build installs from the live Ubuntu archive instead and
# prints a warning. Either way /etc/gap-finder-apt-source records where the
# packages came from ("snapshot <date>" or "live archive <time>"). On an LTS
# release the live archive differs from the snapshot only by stable and
# security updates, so GDAL/GEOS/PROJ keep their versions up to the patch level.
ARG APT_SNAPSHOT=20261109T000000Z

FROM rocker/r-ver:4.6.2@sha256:8739c76d2d9316698a7145b032601f1e82249fdee34670d7b4a0a40d6bacd95a AS builder
ARG APT_SNAPSHOT

ENV DEBIAN_FRONTEND=noninteractive
ENV RENV_CONFIG_PAK_ENABLED=FALSE

# librdf0-dev: `redland` (via rdflib <- mregions2, the optional marine EEZ
# fetcher) compiles against the Redland C libraries (librdf/raptor/rasqal).
# renv::restore() installs every package in renv.lock, not only what app.R
# loads, so without it the image build fails at `redland`. Package names are
# for Ubuntu 26.04 (resolute), the base of rocker/r-ver:4.6.2 (4.6.1 and older
# are on 24.04, noble).
# libuv1-dev: fs >= 2.0 builds against the system libuv instead of its own copy.
RUN echo "APT::Snapshot \"${APT_SNAPSHOT}\";" > /etc/apt/apt.conf.d/50snapshot \
    && echo 'Acquire::Retries "8"; Acquire::Retries::Delay::Maximum "60";' > /etc/apt/apt.conf.d/80retries \
    && src="snapshot ${APT_SNAPSHOT}" \
    && for try in 1 2; do apt-get update --error-on=any && break; \
         if [ "$try" -eq 1 ]; then echo "apt-get update failed, retrying in 60 s"; sleep 60; continue; fi; \
         echo "WARNING: snapshot.ubuntu.com is unavailable; installing from the live Ubuntu archive" >&2; \
         rm /etc/apt/apt.conf.d/50snapshot; src="live archive $(date -u +%Y-%m-%dT%H:%MZ)"; \
         apt-get update --error-on=any || exit 100; done \
    && apt-get install -y --no-install-recommends \
    cmake \
    g++ \
    gdal-bin \
    libcurl4-openssl-dev \
    libfontconfig1-dev \
    libfribidi-dev \
    libfreetype-dev \
    libgdal-dev \
    libgeos-dev \
    libglpk-dev \
    libharfbuzz-dev \
    libjpeg-dev \
    libpng-dev \
    libproj-dev \
    librdf0-dev \
    libssl-dev \
    libtiff5-dev \
    libudunits2-dev \
    libuv1-dev \
    libxml2-dev \
    make \
    && echo "$src" > /etc/gap-finder-apt-source \
    && rm -rf /var/lib/apt/lists/*

RUN R -q -e "install.packages('renv', repos = 'https://packagemanager.posit.co/cran/latest')"

WORKDIR /opt/project

COPY renv.lock ./renv.lock

RUN R -q -e "renv::consent(provided = TRUE); renv::restore(lockfile = 'renv.lock', library = '/usr/local/lib/R/site-library', prompt = FALSE)"

# Runtime stage: the shared libraries the compiled packages load, and nothing
# to build with. It ends before the app and its LFS data bundle, so the PR
# workflow (build-image-pr.yml) can build and check it without fetching LFS.
FROM rocker/r-ver:4.6.2@sha256:8739c76d2d9316698a7145b032601f1e82249fdee34670d7b4a0a40d6bacd95a AS runtime
ARG APT_SNAPSHOT

ENV DEBIAN_FRONTEND=noninteractive

# Ubuntu 26.04 names: the 64-bit time_t libraries end in t64, and libxml2 2.14+
# ships as libxml2-16 (there is no plain libxml2 package). libuv1t64 is for fs.
RUN echo "APT::Snapshot \"${APT_SNAPSHOT}\";" > /etc/apt/apt.conf.d/50snapshot \
    && echo 'Acquire::Retries "8"; Acquire::Retries::Delay::Maximum "60";' > /etc/apt/apt.conf.d/80retries \
    && src="snapshot ${APT_SNAPSHOT}" \
    && for try in 1 2; do apt-get update --error-on=any && break; \
         if [ "$try" -eq 1 ]; then echo "apt-get update failed, retrying in 60 s"; sleep 60; continue; fi; \
         echo "WARNING: snapshot.ubuntu.com is unavailable; installing from the live Ubuntu archive" >&2; \
         rm /etc/apt/apt.conf.d/50snapshot; src="live archive $(date -u +%Y-%m-%dT%H:%MZ)"; \
         apt-get update --error-on=any || exit 100; done \
    && apt-get install -y --no-install-recommends \
    libcurl4t64 \
    libfontconfig1 \
    libfribidi0 \
    libfreetype6 \
    libgdal-dev \
    libgeos-dev \
    libglpk40 \
    libharfbuzz0b \
    libjpeg-dev \
    libpng16-16t64 \
    libproj-dev \
    librdf0t64 \
    libssl3t64 \
    libtiff6 \
    libudunits2-0 \
    libuv1t64 \
    libxml2-16 \
    && echo "$src" > /etc/gap-finder-apt-source \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/R/site-library /usr/local/lib/R/site-library

# Fail the build if a compiled package needs a shared library this stage does
# not install: a library renamed by an Ubuntu move, or a new system dependency
# of an updated package. ldd runs from inside R so that R's own lib directory
# is on the search path.
RUN R -q -e "so <- list.files('/usr/local/lib/R/site-library', pattern = '[.]so\$', recursive = TRUE, full.names = TRUE); miss <- unique(unlist(lapply(so, function(f) grep('not found', suppressWarnings(system2('ldd', f, stdout = TRUE)), value = TRUE)))); if (length(miss)) { writeLines(sort(miss)); stop('shared libraries missing in the runtime stage') }; cat('OK:', length(so), 'shared objects find their libraries\n')"

FROM runtime

# Country selector — override at build time with --build-arg GBIF_GAP_COUNTRY=NO.
# Drives which config + data bundle are copied and the app's runtime lookup.
ARG GBIF_GAP_COUNTRY=SE
ENV GBIF_GAP_COUNTRY=${GBIF_GAP_COUNTRY}

# Release version, baked in at build time — CI passes the pushed git tag. There
# is no git inside the image, so this environment variable is what app.R reads
# (Sys.getenv("GAP_FINDER_VERSION", "dev")). A local `docker build` with no
# --build-arg produces an image that honestly reports itself as "dev".
ARG GAP_FINDER_VERSION=dev
ENV GAP_FINDER_VERSION=${GAP_FINDER_VERSION}

WORKDIR /opt/project

# Country config, kept alongside the app for provenance (country is baked into
# the bundle metadata; app.R does not read this file at runtime).
COPY configs/config_${GBIF_GAP_COUNTRY}.yml ./configs/config_${GBIF_GAP_COUNTRY}.yml

# App code + data bundle + static assets (styles, self-hosted fonts)
COPY shiny_app/gap_finder/app.R         ./shiny_app/gap_finder/app.R
COPY shiny_app/gap_finder/data/${GBIF_GAP_COUNTRY}/shiny_data.rds ./shiny_app/gap_finder/data/${GBIF_GAP_COUNTRY}/shiny_data.rds
COPY shiny_app/gap_finder/www/ ./shiny_app/gap_finder/www/

# Fail the build if Git LFS was not fetched and the bundle is still a pointer
# file (~130 bytes) instead of the real ~90 MB RDS. Catches a broken image at
# build time (red CI) rather than at container start.
RUN R -q -e "stopifnot(file.exists('shiny_app/gap_finder/data/${GBIF_GAP_COUNTRY}/shiny_data.rds')); invisible(readRDS('shiny_app/gap_finder/data/${GBIF_GAP_COUNTRY}/shiny_data.rds')); cat('OK: data bundle is a real RDS\n')"

EXPOSE 3838

WORKDIR /opt/project/shiny_app/gap_finder

CMD ["R", "-q", "-e", "options(shiny.host = '0.0.0.0', shiny.port = 3838); shiny::runApp('.')"]
